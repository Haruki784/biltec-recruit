# 改行コードは LF にそろえる（Windows / Mac 混在でも差分が出ないように）
* text=auto eol=lf
*.png binary
*.jpg binary
*.webp binary
*.zip binary

# 本番用 ZIP（_tools/make-theme-zip.ps1 = git archive）に入れないもの
# 制作用の資料・設定。サーバーに上げると URL で中身が見えてしまう
/.claude          export-ignore
/.gitattributes   export-ignore
/.gitignore       export-ignore
/CLAUDE.md        export-ignore
/docs             export-ignore
/_design          export-ignore
/_samples         export-ignore
/_tools           export-ignore
/page-capture     export-ignore
/option/option.html export-ignore
*.md              export-ignore
